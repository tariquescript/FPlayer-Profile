# Where the app gets its data.
#
#   (empty)                      talk straight to the Transfermarkt API
#   /                            gateway is on this origin (dev proxy, or a
#                                rewrite in front of the deployed site)
#   https://your-gateway.app     gateway deployed separately
#
# The gateway (server/) aggregates and caches, so a profile page is one request
# instead of seven.
VITE_API_BASE=

# Override only if you deploy your own copy of the Transfermarkt API.
VITE_UPSTREAM_URL=https://transfermarkt-api-82dl.onrender.com
