# Upstream Transfermarkt API (the FastAPI service deployed on Render)
UPSTREAM_URL=https://transfermarkt-api-82dl.onrender.com

PORT=8787

# Comma separated list, or * for any origin
CORS_ORIGINS=*

# This service's public URL on Render, so the heartbeat keeps it awake
SELF_URL=
KEEP_ALIVE=true

# The upstream scrapes transfermarkt.com and refuses bursts; keep this low
UPSTREAM_CONCURRENCY=4
UPSTREAM_RETRIES=3

# Popular searches pre-loaded on boot and every 6 hours
WARM_CACHE=true
# WARM_QUERIES=haaland,mbappe,bellingham

CACHE_MAX_ENTRIES=3000
RATE_LIMIT_MAX=240
